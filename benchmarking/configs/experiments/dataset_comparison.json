{
        "experiment": "dataset-comparison",
        "bench_cmd_extra": "--backend openai --num-prompts 100 --save-result --save-detailed --num-warmups 20 --ignore-eos --max-concurrency 1",
        "bench_params":[    
            {
                "dataset-name": "sharegpt",
                "dataset-path": "./datasets/random_prompt_dataset.json",
                "sharegpt-output-len": 64
            },
            {
                "dataset-name": "sharegpt",
                "dataset-path": "./datasets/easy_prompt_dataset.json",
                "sharegpt-output-len": 64
            },
            {
                "dataset-name": "sharegpt",
                "dataset-path": "./datasets/harder_prompt_dataset.json",
                "sharegpt-output-len": 64
            }],
        "serve_params":[
            {"enable-prefix-caching": true},
            {"enable-prefix-caching": false}],
        "serve_cmd_extra": "--port 8000 --max-num-seqs 2048 --max-model-len 2048"
