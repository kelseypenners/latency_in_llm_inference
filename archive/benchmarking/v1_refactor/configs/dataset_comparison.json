{
    "experiment": "dataset-comparison",
    "experiment_type": "single-gpu",
    "gpu_ids": "7",
    "gpu_type": "a100",
    "model": "../Llama-3.1-8B",
    "results": "../results",
    "runs": 2,
    "gpu_mem": 0.85,
    "serve_cmd_extra": "--port 8000",
    "bench_cmd_extra": "--backend openai --num-prompts 100 --save-result --save-detailed --num-warmups 20 --ignore-eos --max-concurrency 1",
    "bench_params":[    
        {
            "dataset-name": "sharegpt",
            "dataset-path": "./random_prompt_dataset.json",
            "sharegpt-output-len": 64
        },
        {
            "dataset-name": "sharegpt",
            "dataset-path": "./easy_prompt_dataset.json",
            "sharegpt-output-len": 64
        },
        {
            "dataset-name": "sharegpt",
            "dataset-path": "./harder_prompt_dataset.json",
            "sharegpt-output-len": 64
        }],
    "serve_params":[
        {"enable-prefix-caching": true},
        {"enable-prefix-caching": false}],
    "dry_run": "true"

}
